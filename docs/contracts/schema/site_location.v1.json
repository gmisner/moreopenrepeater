{
  "$defs": {
    "FixQuality": {
      "enum": [
        "none",
        "2d",
        "3d"
      ],
      "title": "FixQuality",
      "type": "string"
    },
    "Freshness": {
      "additionalProperties": false,
      "description": "How old a value is allowed to be before a consumer must stop trusting it.\n\nA stale GPS fix, a stale weather alert and a stale status all use this, so\nconsumers handle \"old data\" one way.",
      "properties": {
        "max_age_s": {
          "exclusiveMinimum": 0,
          "title": "Max Age S",
          "type": "number"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        }
      },
      "required": [
        "observed_at",
        "max_age_s"
      ],
      "title": "Freshness",
      "type": "object"
    },
    "Header": {
      "additionalProperties": false,
      "description": "Common header on commands, events, health, status and config messages.",
      "properties": {
        "boot_id": {
          "pattern": "^[A-Za-z0-9_-]{8,64}$",
          "title": "Boot Id",
          "type": "string"
        },
        "correlation_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9_-]{8,64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Correlation Id"
        },
        "emitted_at": {
          "format": "date-time",
          "title": "Emitted At",
          "type": "string"
        },
        "message_id": {
          "pattern": "^[A-Za-z0-9_-]{8,64}$",
          "title": "Message Id",
          "type": "string"
        },
        "request_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9_-]{8,64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Request Id"
        },
        "schema_version": {
          "minimum": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "seq": {
          "minimum": 0,
          "title": "Seq",
          "type": "integer"
        },
        "source": {
          "$ref": "#/$defs/Source"
        }
      },
      "required": [
        "schema_version",
        "message_id",
        "emitted_at",
        "boot_id",
        "seq",
        "source"
      ],
      "title": "Header",
      "type": "object"
    },
    "LocationSource": {
      "enum": [
        "fixed",
        "gps"
      ],
      "title": "LocationSource",
      "type": "string"
    },
    "Source": {
      "additionalProperties": false,
      "properties": {
        "module": {
          "pattern": "^[a-z][a-z0-9_-]{0,31}$",
          "title": "Module",
          "type": "string"
        },
        "version": {
          "maxLength": 32,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "module",
        "version"
      ],
      "title": "Source",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Where the repeater is. One source of truth: weather, APRS, the map and\nother services read this and never open the GPS device (ADR 0005 item 8).\n\nThe coordinates are real. The log filter coarsens them, and a support\nbundle must do the same.",
  "properties": {
    "altitude_m": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Altitude M"
    },
    "fix": {
      "anyOf": [
        {
          "$ref": "#/$defs/FixQuality"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "freshness": {
      "anyOf": [
        {
          "$ref": "#/$defs/Freshness"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "header": {
      "$ref": "#/$defs/Header"
    },
    "kind": {
      "const": "site.location",
      "default": "site.location",
      "title": "Kind",
      "type": "string"
    },
    "latitude": {
      "maximum": 90,
      "minimum": -90,
      "title": "Latitude",
      "type": "number"
    },
    "longitude": {
      "maximum": 180,
      "minimum": -180,
      "title": "Longitude",
      "type": "number"
    },
    "source": {
      "$ref": "#/$defs/LocationSource"
    }
  },
  "required": [
    "header",
    "source",
    "latitude",
    "longitude"
  ],
  "title": "SiteLocation",
  "type": "object"
}
