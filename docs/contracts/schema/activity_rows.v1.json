{
  "$defs": {
    "ActivityEntry": {
      "description": "One thing the core recorded: a reception, a transmission, an ID, an announcement, a\nfiltered kerchunk or a lockout.",
      "properties": {
        "duration": {
          "minimum": 0,
          "title": "Duration",
          "type": "number"
        },
        "kind": {
          "maxLength": 32,
          "title": "Kind",
          "type": "string"
        },
        "started_at": {
          "title": "Started At",
          "type": "number"
        },
        "timed_out": {
          "default": false,
          "title": "Timed Out",
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "started_at",
        "duration"
      ],
      "title": "ActivityEntry",
      "type": "object"
    },
    "Header": {
      "additionalProperties": false,
      "description": "Common header on commands, events, health, status and config messages.",
      "properties": {
        "boot_id": {
          "pattern": "^[A-Za-z0-9_-]{8,64}$",
          "title": "Boot Id",
          "type": "string"
        },
        "correlation_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9_-]{8,64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Correlation Id"
        },
        "emitted_at": {
          "format": "date-time",
          "title": "Emitted At",
          "type": "string"
        },
        "message_id": {
          "pattern": "^[A-Za-z0-9_-]{8,64}$",
          "title": "Message Id",
          "type": "string"
        },
        "request_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9_-]{8,64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Request Id"
        },
        "schema_version": {
          "minimum": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "seq": {
          "minimum": 0,
          "title": "Seq",
          "type": "integer"
        },
        "source": {
          "$ref": "#/$defs/Source"
        }
      },
      "required": [
        "schema_version",
        "message_id",
        "emitted_at",
        "boot_id",
        "seq",
        "source"
      ],
      "title": "Header",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "properties": {
        "module": {
          "pattern": "^[a-z][a-z0-9_-]{0,31}$",
          "title": "Module",
          "type": "string"
        },
        "version": {
          "maxLength": 32,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "module",
        "version"
      ],
      "title": "Source",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "What the core recorded about use of the repeater, from `GET /activity`. The core is the one\nthat sees every transmission, so it records them; the dashboard reads them here. Oldest first,\nor newest first when the request asked for the most recent. `truncated` says the core had more\nthan it was willing to send for the window. For the API's trusted channel.",
  "properties": {
    "header": {
      "$ref": "#/$defs/Header"
    },
    "kind": {
      "const": "activity.rows",
      "default": "activity.rows",
      "title": "Kind",
      "type": "string"
    },
    "rows": {
      "items": {
        "$ref": "#/$defs/ActivityEntry"
      },
      "maxItems": 20000,
      "title": "Rows",
      "type": "array"
    },
    "truncated": {
      "default": false,
      "title": "Truncated",
      "type": "boolean"
    }
  },
  "required": [
    "header",
    "rows"
  ],
  "title": "ActivityRows",
  "type": "object"
}
