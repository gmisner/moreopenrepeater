{
  "$defs": {
    "Header": {
      "additionalProperties": false,
      "description": "Common header on commands, events, health, status and config messages.",
      "properties": {
        "boot_id": {
          "pattern": "^[A-Za-z0-9_-]{8,64}$",
          "title": "Boot Id",
          "type": "string"
        },
        "correlation_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9_-]{8,64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Correlation Id"
        },
        "emitted_at": {
          "format": "date-time",
          "title": "Emitted At",
          "type": "string"
        },
        "message_id": {
          "pattern": "^[A-Za-z0-9_-]{8,64}$",
          "title": "Message Id",
          "type": "string"
        },
        "request_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9_-]{8,64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Request Id"
        },
        "schema_version": {
          "minimum": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "seq": {
          "minimum": 0,
          "title": "Seq",
          "type": "integer"
        },
        "source": {
          "$ref": "#/$defs/Source"
        }
      },
      "required": [
        "schema_version",
        "message_id",
        "emitted_at",
        "boot_id",
        "seq",
        "source"
      ],
      "title": "Header",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "properties": {
        "module": {
          "pattern": "^[a-z][a-z0-9_-]{0,31}$",
          "title": "Module",
          "type": "string"
        },
        "version": {
          "maxLength": 32,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "module",
        "version"
      ],
      "title": "Source",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "What the core's own hardware reports: audio engine, GPIO, fan, link radio, remote base,\nmonitor receiver, autopatch, AllStar node and DMR (`GET /hardware`), each its status as a plain\nobject. For the API's trusted channel, so the dashboard's pages about them work with the core in\nanother process. A part that could not be read in time is listed in `unavailable`, not guessed.",
  "properties": {
    "header": {
      "$ref": "#/$defs/Header"
    },
    "kind": {
      "const": "core.hardware",
      "default": "core.hardware",
      "title": "Kind",
      "type": "string"
    },
    "statuses": {
      "additionalProperties": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Statuses",
      "type": "object"
    },
    "unavailable": {
      "items": {
        "type": "string"
      },
      "maxItems": 32,
      "title": "Unavailable",
      "type": "array"
    }
  },
  "required": [
    "header",
    "statuses"
  ],
  "title": "CoreHardware",
  "type": "object"
}
