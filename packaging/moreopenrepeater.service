[Unit]
Description=moreopenrepeater repeater controller API/dashboard
After=network-online.target
Wants=network-online.target

[Service]
# It tells systemd when it has started, then keeps pinging while the
# controller and the audio engine are working (api/watchdog.py). If the pings
# stop, systemd kills it and Restart= starts it again.
Type=notify
WatchdogSec=30
TimeoutStartSec=120
User=moreopenrepeater
Group=moreopenrepeater
WorkingDirectory=/opt/moreopenrepeater
# Multithreaded BLAS makes the audio worker's small matrix products late now
# and then on a Pi (waking the other cores costs more than it saves).
Environment=OPENBLAS_NUM_THREADS=1
# The dashboard's Updates page asks moreopenrepeater-update.path for an
# update by writing the request file, and reads progress from the updater's
# state directory.
Environment=MOREOPENREPEATER_UPDATER=/var/lib/moreopenrepeater-update
Environment=MOREOPENREPEATER_UPDATE_REQUEST=/opt/moreopenrepeater/data/update-request
EnvironmentFile=/etc/moreopenrepeater/env
# /run/moreopenrepeater (in memory) holds the log when the SD card is
# protected (install-pi.sh --protect-sd); kept across restarts until reboot.
RuntimeDirectory=moreopenrepeater
RuntimeDirectoryPreserve=yes
ExecStart=/opt/moreopenrepeater/.venv/bin/moreopenrepeater-api
Restart=on-failure
RestartSec=5

# Modest hardening -- not locked down further since the process needs real
# device access (/dev/hidrawN for audio_io.cm108, sound devices for
# sounddevice) that's awkward to enumerate up front in a DeviceAllow list.
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
