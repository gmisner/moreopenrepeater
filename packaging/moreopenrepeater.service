[Unit]
Description=moreopenrepeater repeater controller API/dashboard
After=network-online.target
Wants=network-online.target

[Service]
# It tells systemd when it has started, then keeps pinging while the
# controller and the audio engine are working (api/watchdog.py). If the pings
# stop, systemd kills it and Restart= starts it again.
Type=notify
WatchdogSec=30
# Piper/Kokoro first speak can still take a while while ONNX loads.
TimeoutStartSec=180
User=moreopenrepeater
Group=moreopenrepeater
# Support bundles run journalctl -u moreopenrepeater from this process.
SupplementaryGroups=systemd-journal
WorkingDirectory=/opt/moreopenrepeater
# Multithreaded BLAS makes the audio worker's small matrix products late now
# and then on a Pi (waking the other cores costs more than it saves).
Environment=OPENBLAS_NUM_THREADS=1
# venv first so `piper` / `kokoro` (and other console scripts) resolve for TTS.
Environment=PATH=/opt/moreopenrepeater/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
# Piper voices live under data/ so they survive venv swaps.
Environment=PIPER_DATA_DIR=/opt/moreopenrepeater/data/piper
Environment=PIPER_VOICE=en_GB-cori-medium
# Long-lived piper.http_server keeps the ONNX model warm (CLI reloads every speak).
Environment=PIPER_SERVICE_URL=http://127.0.0.1:8766
# Kokoro models (~120 MB) when kokoro-cli is still installed on this site.
Environment=KOKORO_HOME=/opt/moreopenrepeater/data/kokoro
# The dashboard's Updates page asks moreopenrepeater-update.path for an
# update by writing the request file, and reads progress from the updater's
# state directory. Remote access (Tailscale) uses the same pattern.
Environment=MOREOPENREPEATER_UPDATER=/var/lib/moreopenrepeater-update
Environment=MOREOPENREPEATER_UPDATE_REQUEST=/opt/moreopenrepeater/data/update-request
Environment=MOREOPENREPEATER_TAILSCALE=/var/lib/moreopenrepeater-tailscale
Environment=MOREOPENREPEATER_TAILSCALE_REQUEST=/opt/moreopenrepeater/data/tailscale-request
Environment=MOREOPENREPEATER_RESTART_REQUEST=/opt/moreopenrepeater/data/restart-request
EnvironmentFile=/etc/moreopenrepeater/env
# /run/moreopenrepeater (in memory) holds the log when the SD card is
# protected (install-pi.sh --protect-sd); kept across restarts until reboot.
RuntimeDirectory=moreopenrepeater
RuntimeDirectoryPreserve=yes
ExecStart=/opt/moreopenrepeater/.venv/bin/moreopenrepeater-api
Restart=on-failure
RestartSec=5

# Modest hardening -- not locked down further since the process needs real
# device access (/dev/hidrawN for audio_io.cm108, sound devices for
# sounddevice) that's awkward to enumerate up front in a DeviceAllow list.
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
