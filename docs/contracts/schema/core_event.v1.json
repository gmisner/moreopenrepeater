{
  "$defs": {
    "Header": {
      "additionalProperties": false,
      "description": "Common header on commands, events, health, status and config messages.",
      "properties": {
        "boot_id": {
          "pattern": "^[A-Za-z0-9_-]{8,64}$",
          "title": "Boot Id",
          "type": "string"
        },
        "correlation_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9_-]{8,64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Correlation Id"
        },
        "emitted_at": {
          "format": "date-time",
          "title": "Emitted At",
          "type": "string"
        },
        "message_id": {
          "pattern": "^[A-Za-z0-9_-]{8,64}$",
          "title": "Message Id",
          "type": "string"
        },
        "request_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9_-]{8,64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Request Id"
        },
        "schema_version": {
          "minimum": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "seq": {
          "minimum": 0,
          "title": "Seq",
          "type": "integer"
        },
        "source": {
          "$ref": "#/$defs/Source"
        }
      },
      "required": [
        "schema_version",
        "message_id",
        "emitted_at",
        "boot_id",
        "seq",
        "source"
      ],
      "title": "Header",
      "type": "object"
    },
    "PttCommanded": {
      "additionalProperties": false,
      "description": "The core told the PTT output to change state.",
      "properties": {
        "header": {
          "$ref": "#/$defs/Header"
        },
        "keyed": {
          "title": "Keyed",
          "type": "boolean"
        },
        "kind": {
          "const": "ptt.commanded",
          "default": "ptt.commanded",
          "title": "Kind",
          "type": "string"
        },
        "reason": {
          "$ref": "#/$defs/PttReason"
        },
        "transmission_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9_-]{8,64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Transmission Id"
        }
      },
      "required": [
        "header",
        "keyed",
        "reason"
      ],
      "title": "PttCommanded",
      "type": "object"
    },
    "PttEvidence": {
      "enum": [
        "none",
        "gpio_readback",
        "audio_loopback",
        "current_sense",
        "rf_detect"
      ],
      "title": "PttEvidence",
      "type": "string"
    },
    "PttFeedback": {
      "additionalProperties": false,
      "description": "What was observed after a PTT command. `header.request_id` is the\n`message_id` of the `PttCommanded` it follows.",
      "properties": {
        "evidence": {
          "$ref": "#/$defs/PttEvidence"
        },
        "header": {
          "$ref": "#/$defs/Header"
        },
        "kind": {
          "const": "ptt.feedback",
          "default": "ptt.feedback",
          "title": "Kind",
          "type": "string"
        },
        "latency_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latency Ms"
        },
        "observed_keyed": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Observed Keyed"
        },
        "transmission_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9_-]{8,64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Transmission Id"
        }
      },
      "required": [
        "header",
        "observed_keyed",
        "evidence"
      ],
      "title": "PttFeedback",
      "type": "object"
    },
    "PttReason": {
      "enum": [
        "transmission",
        "timeout",
        "watchdog",
        "shutdown",
        "fault"
      ],
      "title": "PttReason",
      "type": "string"
    },
    "Source": {
      "additionalProperties": false,
      "properties": {
        "module": {
          "pattern": "^[a-z][a-z0-9_-]{0,31}$",
          "title": "Module",
          "type": "string"
        },
        "version": {
          "maxLength": 32,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "module",
        "version"
      ],
      "title": "Source",
      "type": "object"
    },
    "TransmissionEnded": {
      "additionalProperties": false,
      "properties": {
        "duration_s": {
          "minimum": 0,
          "title": "Duration S",
          "type": "number"
        },
        "header": {
          "$ref": "#/$defs/Header"
        },
        "kind": {
          "const": "tx.ended",
          "default": "tx.ended",
          "title": "Kind",
          "type": "string"
        },
        "reason": {
          "$ref": "#/$defs/TxEndReason"
        },
        "transmission_id": {
          "pattern": "^[A-Za-z0-9_-]{8,64}$",
          "title": "Transmission Id",
          "type": "string"
        }
      },
      "required": [
        "header",
        "transmission_id",
        "reason",
        "duration_s"
      ],
      "title": "TransmissionEnded",
      "type": "object"
    },
    "TransmissionStarted": {
      "additionalProperties": false,
      "properties": {
        "header": {
          "$ref": "#/$defs/Header"
        },
        "kind": {
          "const": "tx.started",
          "default": "tx.started",
          "title": "Kind",
          "type": "string"
        },
        "source": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "transmission_id": {
          "pattern": "^[A-Za-z0-9_-]{8,64}$",
          "title": "Transmission Id",
          "type": "string"
        }
      },
      "required": [
        "header",
        "transmission_id",
        "source"
      ],
      "title": "TransmissionStarted",
      "type": "object"
    },
    "TxEndReason": {
      "enum": [
        "complete",
        "timeout",
        "preempted",
        "fault"
      ],
      "title": "TxEndReason",
      "type": "string"
    }
  },
  "discriminator": {
    "mapping": {
      "ptt.commanded": "#/$defs/PttCommanded",
      "ptt.feedback": "#/$defs/PttFeedback",
      "tx.ended": "#/$defs/TransmissionEnded",
      "tx.started": "#/$defs/TransmissionStarted"
    },
    "propertyName": "kind"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/PttCommanded"
    },
    {
      "$ref": "#/$defs/PttFeedback"
    },
    {
      "$ref": "#/$defs/TransmissionStarted"
    },
    {
      "$ref": "#/$defs/TransmissionEnded"
    }
  ]
}
