# Site settings passed into the core container (copy to core.env). Anything the
# systemd install keeps in /etc/moreopenrepeater/env goes here.
#
# With the AllStar node as a container (docker compose --profile allstar ...), the core reaches it on the private
# network. The addresses the core listens on and tells Asterisk to use are set in compose.yaml. These are yours:
#
# Where the node's USRP port is, which turns on the radio's audio to and from AllStar (the node's address in compose.yaml
# is MOR_ALLSTAR_IP, 172.28.0.20 by default). The dashboard's AllStar setup writes the node's side of this.
# MOREOPENREPEATER_USRP_NODE=172.28.0.20:32001
# The node's management interface, for autopatch calls and restarting the node. The secret is MOR_AMI_SECRET from
# allstar.env, the same value in api.env.
# MOREOPENREPEATER_AMI_HOST=allstar
# MOREOPENREPEATER_AMI_PORT=5038
# MOREOPENREPEATER_AMI_USER=admin
# MOREOPENREPEATER_AMI_SECRET=

# How many seconds the controller or the audio engine may go without progress before the core counts it as
# stalled (default 10, from 2 to 300). The container's health check and the watchdog that restarts the core
# (MOREOPENREPEATER_EXIT_ON_STALL, set in compose.yaml) both use it. It is also how long the transmitter can
# stay keyed if the sound card vanishes mid-transmission. See "Health and restarts" in docs/docker.md.
# MOREOPENREPEATER_STALL_SECONDS=10
