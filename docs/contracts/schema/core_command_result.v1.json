{
  "$defs": {
    "CommandStatus": {
      "enum": [
        "applied",
        "rejected"
      ],
      "title": "CommandStatus",
      "type": "string"
    },
    "Header": {
      "additionalProperties": false,
      "description": "Common header on commands, events, health, status and config messages.",
      "properties": {
        "boot_id": {
          "pattern": "^[A-Za-z0-9_-]{8,64}$",
          "title": "Boot Id",
          "type": "string"
        },
        "correlation_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9_-]{8,64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Correlation Id"
        },
        "emitted_at": {
          "format": "date-time",
          "title": "Emitted At",
          "type": "string"
        },
        "message_id": {
          "pattern": "^[A-Za-z0-9_-]{8,64}$",
          "title": "Message Id",
          "type": "string"
        },
        "request_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9_-]{8,64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Request Id"
        },
        "schema_version": {
          "minimum": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "seq": {
          "minimum": 0,
          "title": "Seq",
          "type": "integer"
        },
        "source": {
          "$ref": "#/$defs/Source"
        }
      },
      "required": [
        "schema_version",
        "message_id",
        "emitted_at",
        "boot_id",
        "seq",
        "source"
      ],
      "title": "Header",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "properties": {
        "module": {
          "pattern": "^[a-z][a-z0-9_-]{0,31}$",
          "title": "Module",
          "type": "string"
        },
        "version": {
          "maxLength": 32,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "module",
        "version"
      ],
      "title": "Source",
      "type": "object"
    },
    "StructuredError": {
      "additionalProperties": false,
      "description": "An error a module can return or log. `code` is stable and machine\nreadable; `message` is for people and must not carry secrets or content.",
      "properties": {
        "code": {
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
          "title": "Code",
          "type": "string"
        },
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        },
        "message": {
          "maxLength": 300,
          "title": "Message",
          "type": "string"
        },
        "retry_after_s": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retry After S"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "StructuredError",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The core's answer to a `CoreCommand` (`header.request_id` points at it).",
  "properties": {
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/StructuredError"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "header": {
      "$ref": "#/$defs/Header"
    },
    "kind": {
      "const": "core.command.result",
      "default": "core.command.result",
      "title": "Kind",
      "type": "string"
    },
    "output": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Output"
    },
    "status": {
      "$ref": "#/$defs/CommandStatus"
    }
  },
  "required": [
    "header",
    "status"
  ],
  "title": "CommandResult",
  "type": "object"
}
