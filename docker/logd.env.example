# Settings for the log collector (copy to logd.env). Defaults are what the design asks for.
# MOREOPENREPEATER_LOGD_MAX_MB=64
# MOREOPENREPEATER_LOGD_ROUTINE_DAYS=14
# MOREOPENREPEATER_LOGD_CRITICAL_DAYS=30
# Set by compose.protect-sd.yaml, not here: with the history in memory, errors are also kept in this folder
# on disk and put back after a restart.
# MOREOPENREPEATER_LOGD_CRITICAL_DIR=/var/lib/logd-critical
