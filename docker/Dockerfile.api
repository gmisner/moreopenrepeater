# syntax=docker/dockerfile:1
#
# The dashboard and API on their own: accounts, the web app, backups, alerts, the pages and
# integrations that are not the radio. It holds no device. It talks to the core container over the
# control socket (docs/docker.md, docs/core-only.md). Set MOREOPENREPEATER_CORE_SOCKET to select that.
FROM python:3.13-slim-trixie@sha256:e48f59cdba69a3cbd9ed2cf0f348d90d45a8d350d98134cf1070bc106ee9ed90

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# Same uid as the core, so the data folder and the control socket are shared without chmod games.
RUN groupadd --system --gid 999 moreopenrepeater \
    && useradd --system --uid 999 --gid 999 --home-dir /nonexistent --no-create-home \
       --shell /usr/sbin/nologin moreopenrepeater \
    && mkdir -p /data /run/moreopenrepeater /run/logd /etc/asterisk /etc/moreopenrepeater/dmr /dmr-control /time-config /time-status /winlink-status \
    && chown 999:999 /data /run/moreopenrepeater /run/logd /etc/asterisk /etc/moreopenrepeater/dmr /dmr-control /time-config
# (Where the AllStar node's and the DMR bridge's volumes are mounted for the dashboard to edit, owned by the same uid as the
# node's and the bridge's own, so a volume that this container creates first is writable by all. /time-config is the NTP server
# setting the dashboard writes, which the optional time container reads; /time-status is what that container writes back, mounted
# read-only here, so it is root's like the time container's own. /winlink-status is the same idea for the optional Winlink
# containers' sessions and counters: read-only here, written by them.)

# The project's dependency list from pyproject.toml, pinned to exact versions with hashes (docker/pins/update.sh writes
# docker/api-requirements.txt from it, and a test fails if the two disagree). A rebuild installs those files or fails, so
# ./update.sh cannot bring in a new major of FastAPI, pydantic or the rest by itself. numpy and sounddevice come with it (the app
# imports them) but no audio device is ever opened here.
COPY docker/api-requirements.txt /tmp/api-requirements.txt
RUN pip install --require-hashes --only-binary=:all: -r /tmp/api-requirements.txt

# Run from /app so the app finds its web assets (web/dist) beside src, as it does from a checkout.
COPY src /app/src
COPY web /app/web
ENV PYTHONPATH=/app/src \
    MOREOPENREPEATER_DATA_DIR=/data \
    # Its own log file: the core rotates /data/moreopenrepeater.log, and two writers must not share one.
    MOREOPENREPEATER_LOG_PATH=/data/moreopenrepeater-api.log \
    MOREOPENREPEATER_CORE_SOCKET=/run/moreopenrepeater/core.sock \
    MOREOPENREPEATER_HOST=0.0.0.0 \
    MOREOPENREPEATER_PORT=8000

# Which commit this is, for the dashboard's Updates page. There is no git in this image and no host folder mounted into
# it: docker/update.sh and setup.sh write MOR_COMMIT and the rest into .env, and compose passes them in as build
# arguments (compose.yaml). They sit this late so a new commit rebuilds only this line, not the pip layer. Empty means
# unknown, and the page says so. MOREOPENREPEATER_INSTALL=container is what makes the page a container page.
ARG MOR_COMMIT=""
ARG MOR_COMMIT_DATE=""
ARG MOR_BRANCH=""
ARG MOR_REPO=""
ENV MOREOPENREPEATER_INSTALL=container \
    MOREOPENREPEATER_COMMIT=$MOR_COMMIT \
    MOREOPENREPEATER_COMMIT_DATE=$MOR_COMMIT_DATE \
    MOREOPENREPEATER_BRANCH=$MOR_BRANCH \
    MOREOPENREPEATER_REPO=$MOR_REPO

USER 999:999
WORKDIR /app
VOLUME ["/data"]
EXPOSE 8000

# The dashboard answers on its port. (Whether the core is healthy is the core container's own check.)
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD ["python", "-c", "import socket; socket.create_connection(('127.0.0.1', 8000), 5).close()"]

ENTRYPOINT ["python", "-c", "from api.app import main; main()"]
