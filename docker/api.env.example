# Settings for the dashboard/API container (copy to api.env), the ones the systemd install keeps in
# /etc/moreopenrepeater/env, for example:
# MOREOPENREPEATER_ADMIN_USER=admin
# MOREOPENREPEATER_ADMIN_PASSWORD=change-me
# MOREOPENREPEATER_PORT=8000
# The SIP trunk page talks to Asterisk over AMI from this container, so give it the same settings
# the core has (the systemd install keeps them in /etc/moreopenrepeater/env). With host networking
# the host's Asterisk is at 127.0.0.1.
# MOREOPENREPEATER_AMI_HOST=127.0.0.1
# MOREOPENREPEATER_AMI_PORT=5038
# MOREOPENREPEATER_AMI_USER=admin
# MOREOPENREPEATER_AMI_SECRET=change-me
