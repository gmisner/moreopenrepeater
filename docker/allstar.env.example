# Settings for the AllStarLink node container (copy to allstar.env; see "The AllStar container" in docs/docker.md).
#
# The password of the node's management interface (AMI). Required: the container will not start without it, and
# refuses the package's published default. The API's link service connects with the same value
# (MOREOPENREPEATER_AMI_SECRET in api.env). At least 16 characters: letters, digits and . _ ~ + = -
#   openssl rand -hex 16
# MOR_AMI_SECRET=
#
# The management user's name. The API uses it as MOREOPENREPEATER_AMI_USER.
# MOR_AMI_USER=admin
